model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["FactInternetSales","FactResellerSales","DimCurrency","DimCustomer","DimDate","DimProduct","DimPromotion","DimSalesTerritory","DimEmployee","DimReseller","DimProductCategory","DimProductSubcategory","DimGeography"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","WebModelingEdit","TMDL-Extension"]

annotation __TEdtr = 1

ref table FactInternetSales
ref table FactResellerSales
ref table DimCurrency
ref table DimCustomer
ref table DimDate
ref table DimProduct
ref table DimPromotion
ref table DimSalesTerritory
ref table DimEmployee
ref table DimReseller
ref table DimProductCategory
ref table DimProductSubcategory
ref table DimGeography

ref role 'Australia Sales'

ref perspective Reseller
ref perspective Internet

ref cultureInfo en-US

